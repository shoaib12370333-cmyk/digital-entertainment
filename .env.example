# Copy this file to ".env" and fill in the values from your Firebase project:
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# Restart "npm run dev" (or redeploy on Render with the same variables) after changing them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Your public address without a trailing slash, e.g. https://digital-entertainment.onrender.com
# Used for the picture shown when the link is shared on Facebook, WhatsApp, etc.
VITE_SITE_URL=
